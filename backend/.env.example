SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes extra que pueden llamar a la API, separados por comas.
# - Probar desde un celular en la misma red Wi-Fi: la dirección del frontend
#   en esa red, por ejemplo http://192.168.1.20:5173.
# - Producción: https://fribuk.com
CORS_ALLOWED_ORIGINS=

# Correo de bienvenida (Resend). EMAIL_FROM es el remitente, con un dominio
# verificado en Resend; por ejemplo: FriBuk <hola@fribuk.com>
RESEND_API_KEY=
EMAIL_FROM=

# Opcional. A quién avisar por correo de reportes, retiros automáticos y
# solicitudes de soporte (varias direcciones separadas por comas). Sin
# definirla, los avisos van al correo de cada cuenta administradora.
ADMIN_ALERT_EMAIL=
